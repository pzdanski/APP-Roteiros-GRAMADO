# DUO21 / Roteiro Inteligente - Environment Configuration Template
# COPY TO .env IN YOUR LOCAL ENVIRONMENT AND FILL WITH REAL SECRETS (NEVER COMMIT .env)

# Environment Mode
NODE_ENV=development
DATA_MODE=supabase

# Domain & Canonical URLs (Sprint 8A)
APP_PUBLIC_URL=https://roteiro.duo21.com.br
PUBLIC_APP_ORIGIN=https://roteiro.duo21.com.br

# Security & Admin Authentication
ADMIN_API_KEY=

# Supabase (Source of Truth Database & Auth)
# ATENÇÃO: Nunca exponha SUPABASE_SERVICE_ROLE_KEY no frontend ou bundle client!
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Google Gemini AI (Server-Side parsing e guia inteligente)
GEMINI_API_KEY=

# Google Maps Platform (Google Places, Geocoding e Rotas)
GOOGLE_MAPS_API_KEY=

# Asaas Payment Gateway (PIX e Cartão)
ASAAS_ENV=sandbox
ASAAS_API_KEY=
ASAAS_WEBHOOK_TOKEN=
ASAAS_WEBHOOK_URL=

# Cost Guard (Teto máximo de chamadas de APIs externas por geração de roteiro)
MAX_GENERATION_API_COST_BRL=1.00

# Client-Side Analytics (Opcional)
VITE_GA4_MEASUREMENT_ID=
VITE_CLARITY_PROJECT_ID=
