# GEMINI_API_KEY: Required for Gemini AI server-side processing
GEMINI_API_KEY=

# APP_URL: Host URL of the deployed application
APP_URL=

# SUPABASE (Database principal & RLS)
# Nunca exponha SUPABASE_SERVICE_ROLE_KEY no frontend!
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# ASAAS (Gateway de Pagamento PIX e Cartão)
ASAAS_API_KEY=
ASAAS_ENVIRONMENT=sandbox
ASAAS_WEBHOOK_TOKEN=

# GOOGLE PLACES / MAPS (Opcional para enriquecimento e geocodificação)
GOOGLE_PLACES_API_KEY=

# ANALYTICS (Client-side)
VITE_GA4_MEASUREMENT_ID=
VITE_CLARITY_PROJECT_ID=
